{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "flowName": "SD - Auto Routing & Assignment",
    "flowDescription": "Automatically routes new tickets to the appropriate agent based on department, agent availability, and current workload. Calculates SLA due dates using business hours (skipping weekends). Uses a least-loaded round-robin strategy for fair distribution.",
    "designNotes": {
      "routingStrategy": "1) Look up the ticket's Category to get the DefaultAssignee and SLAHours. 2) Query the Agents list for active agents in the matching department whose CurrentTickets < MaxTickets. 3) Sort by CurrentTickets ascending to find the least-loaded agent. 4) Assign the ticket and update the agent's CurrentTickets count.",
      "slaCalculation": "SLA hours are added to the current UTC time. If the resulting date falls on a weekend (Saturday=6, Sunday=0), the due date is pushed forward to the next Monday at 09:00. Business hours are defined as 08:00-18:00; hours falling outside this window roll to the next business day.",
      "concurrency": "Trigger concurrency is set to 5 to allow parallel processing of multiple new tickets, since the agent assignment uses optimistic concurrency via SharePoint versioning."
    }
  },
  "triggers": {
    "When_a_new_ticket_is_created": {
      "type": "ApiConnection",
      "kind": "V2",
      "inputs": {
        "host": {
          "connection": {
            "name": "@parameters('$connections')['shared_sharepointonline']['connectionId']"
          }
        },
        "method": "get",
        "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('SiteUrl')))}/tables/@{encodeURIComponent(encodeURIComponent(parameters('TicketsListId')))}/onnewitems"
      },
      "recurrence": {
        "frequency": "Minute",
        "interval": 1
      },
      "splitOn": "@triggerBody()?['value']",
      "runtimeConfiguration": {
        "concurrency": {
          "runs": 5,
          "maximumWaitingRuns": 50
        }
      }
    }
  },
  "actions": {
    "Initialize_SLAHours": {
      "type": "InitializeVariable",
      "runAfter": {},
      "inputs": {
        "variables": [
          {
            "name": "SLAHours",
            "type": "integer",
            "value": 24
          }
        ]
      }
    },
    "Initialize_AssignedAgentEmail": {
      "type": "InitializeVariable",
      "runAfter": {
        "Initialize_SLAHours": ["Succeeded"]
      },
      "inputs": {
        "variables": [
          {
            "name": "AssignedAgentEmail",
            "type": "string",
            "value": ""
          }
        ]
      }
    },
    "Initialize_AssignedAgentId": {
      "type": "InitializeVariable",
      "runAfter": {
        "Initialize_AssignedAgentEmail": ["Succeeded"]
      },
      "inputs": {
        "variables": [
          {
            "name": "AssignedAgentId",
            "type": "integer",
            "value": 0
          }
        ]
      }
    },
    "Initialize_SLADueDate": {
      "type": "InitializeVariable",
      "runAfter": {
        "Initialize_AssignedAgentId": ["Succeeded"]
      },
      "inputs": {
        "variables": [
          {
            "name": "SLADueDate",
            "type": "string",
            "value": ""
          }
        ]
      }
    },
    "Initialize_LowestTicketCount": {
      "type": "InitializeVariable",
      "runAfter": {
        "Initialize_SLADueDate": ["Succeeded"]
      },
      "inputs": {
        "variables": [
          {
            "name": "LowestTicketCount",
            "type": "integer",
            "value": 999
          }
        ]
      }
    },
    "Scope_-_Try_Route_Ticket": {
      "type": "Scope",
      "runAfter": {
        "Initialize_LowestTicketCount": ["Succeeded"]
      },
      "actions": {
        "Get_ticket_details": {
          "type": "ApiConnection",
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['shared_sharepointonline']['connectionId']"
              }
            },
            "method": "get",
            "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('SiteUrl')))}/tables/@{encodeURIComponent(encodeURIComponent(parameters('TicketsListId')))}/items/@{triggerBody()?['ID']}"
          },
          "runAfter": {}
        },
        "Get_category_details": {
          "type": "ApiConnection",
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['shared_sharepointonline']['connectionId']"
              }
            },
            "method": "get",
            "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('SiteUrl')))}/tables/@{encodeURIComponent(encodeURIComponent(parameters('CategoriesListId')))}/items",
            "queries": {
              "$filter": "ID eq @{body('Get_ticket_details')?['Category']?['Id']}",
              "$top": 1
            }
          },
          "runAfter": {
            "Get_ticket_details": ["Succeeded"]
          },
          "description": "Look up the Category to get DefaultAssignee and SLAHours."
        },
        "Check_if_category_found": {
          "type": "If",
          "runAfter": {
            "Get_category_details": ["Succeeded"]
          },
          "expression": {
            "and": [
              {
                "greater": [
                  "@length(body('Get_category_details')?['value'])",
                  0
                ]
              }
            ]
          },
          "actions": {
            "Set_SLAHours_from_category": {
              "type": "SetVariable",
              "inputs": {
                "name": "SLAHours",
                "value": "@int(first(body('Get_category_details')?['value'])?['SLAHours'])"
              },
              "runAfter": {}
            }
          },
          "else": {
            "actions": {
              "Set_default_SLA_24h": {
                "type": "SetVariable",
                "inputs": {
                  "name": "SLAHours",
                  "value": 24
                },
                "runAfter": {}
              }
            }
          }
        },
        "Get_available_agents": {
          "type": "ApiConnection",
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['shared_sharepointonline']['connectionId']"
              }
            },
            "method": "get",
            "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('SiteUrl')))}/tables/@{encodeURIComponent(encodeURIComponent(parameters('AgentsListId')))}/items",
            "queries": {
              "$filter": "Department eq '@{body('Get_ticket_details')?['Department']}' and IsActive eq 1",
              "$orderby": "CurrentTickets asc"
            }
          },
          "runAfter": {
            "Check_if_category_found": ["Succeeded"]
          },
          "description": "Query Agents list for active agents in the ticket's department, ordered by current ticket count ascending."
        },
        "Filter_agents_under_max_capacity": {
          "type": "Query",
          "inputs": {
            "from": "@body('Get_available_agents')?['value']",
            "where": "@less(item()?['CurrentTickets'], item()?['MaxTickets'])"
          },
          "runAfter": {
            "Get_available_agents": ["Succeeded"]
          },
          "description": "Filter to only agents whose CurrentTickets < MaxTickets."
        },
        "Check_if_agents_available": {
          "type": "If",
          "runAfter": {
            "Filter_agents_under_max_capacity": ["Succeeded"]
          },
          "expression": {
            "and": [
              {
                "greater": [
                  "@length(body('Filter_agents_under_max_capacity'))",
                  0
                ]
              }
            ]
          },
          "actions": {
            "Select_least_loaded_agent": {
              "type": "Compose",
              "inputs": "@first(body('Filter_agents_under_max_capacity'))",
              "runAfter": {},
              "description": "Since agents are already sorted by CurrentTickets asc, the first item is the least loaded."
            },
            "Set_AssignedAgentEmail": {
              "type": "SetVariable",
              "inputs": {
                "name": "AssignedAgentEmail",
                "value": "@outputs('Select_least_loaded_agent')?['AgentEmail']"
              },
              "runAfter": {
                "Select_least_loaded_agent": ["Succeeded"]
              }
            },
            "Set_AssignedAgentId": {
              "type": "SetVariable",
              "inputs": {
                "name": "AssignedAgentId",
                "value": "@int(outputs('Select_least_loaded_agent')?['ID'])"
              },
              "runAfter": {
                "Set_AssignedAgentEmail": ["Succeeded"]
              }
            },
            "Increment_agent_ticket_count": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['shared_sharepointonline']['connectionId']"
                  }
                },
                "method": "patch",
                "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('SiteUrl')))}/tables/@{encodeURIComponent(encodeURIComponent(parameters('AgentsListId')))}/items/@{outputs('Select_least_loaded_agent')?['ID']}",
                "body": {
                  "CurrentTickets": "@add(int(outputs('Select_least_loaded_agent')?['CurrentTickets']), 1)"
                }
              },
              "runAfter": {
                "Set_AssignedAgentId": ["Succeeded"]
              },
              "runtimeConfiguration": {
                "retryPolicy": {
                  "type": "exponential",
                  "count": 3,
                  "interval": "PT5S",
                  "minimumInterval": "PT5S",
                  "maximumInterval": "PT30S"
                }
              }
            }
          },
          "else": {
            "actions": {
              "Use_category_default_assignee": {
                "type": "If",
                "runAfter": {},
                "expression": {
                  "and": [
                    {
                      "greater": [
                        "@length(body('Get_category_details')?['value'])",
                        0
                      ]
                    },
                    {
                      "not": {
                        "equals": [
                          "@first(body('Get_category_details')?['value'])?['DefaultAssignee']",
                          null
                        ]
                      }
                    }
                  ]
                },
                "actions": {
                  "Set_default_assignee_email": {
                    "type": "SetVariable",
                    "inputs": {
                      "name": "AssignedAgentEmail",
                      "value": "@first(body('Get_category_details')?['value'])?['DefaultAssignee']?['Email']"
                    },
                    "runAfter": {}
                  }
                },
                "else": {
                  "actions": {
                    "Set_fallback_to_unassigned": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "AssignedAgentEmail",
                        "value": "@parameters('FallbackAgentEmail')"
                      },
                      "runAfter": {}
                    }
                  }
                },
                "description": "If no agents are under capacity, fall back to the category's DefaultAssignee. If that is also empty, use the configured fallback agent."
              }
            }
          }
        },
        "Calculate_raw_SLA_due_date": {
          "type": "Compose",
          "inputs": "@addHours(utcNow(), variables('SLAHours'))",
          "runAfter": {
            "Check_if_agents_available": ["Succeeded"]
          },
          "description": "Initial SLA calculation: current time + SLA hours."
        },
        "Calculate_day_of_week": {
          "type": "Compose",
          "inputs": "@dayOfWeek(outputs('Calculate_raw_SLA_due_date'))",
          "runAfter": {
            "Calculate_raw_SLA_due_date": ["Succeeded"]
          },
          "description": "0=Sunday, 1=Monday, ..., 6=Saturday"
        },
        "Adjust_SLA_for_weekends": {
          "type": "If",
          "runAfter": {
            "Calculate_day_of_week": ["Succeeded"]
          },
          "expression": {
            "or": [
              {
                "equals": ["@outputs('Calculate_day_of_week')", 6]
              },
              {
                "equals": ["@outputs('Calculate_day_of_week')", 0]
              }
            ]
          },
          "actions": {
            "Calculate_days_to_monday": {
              "type": "Compose",
              "inputs": "@if(equals(outputs('Calculate_day_of_week'), 6), 2, 1)",
              "runAfter": {},
              "description": "Saturday needs +2 days, Sunday needs +1 day to reach Monday."
            },
            "Set_SLA_to_next_monday_morning": {
              "type": "SetVariable",
              "inputs": {
                "name": "SLADueDate",
                "value": "@formatDateTime(addDays(outputs('Calculate_raw_SLA_due_date'), outputs('Calculate_days_to_monday')), 'yyyy-MM-ddT09:00:00Z')"
              },
              "runAfter": {
                "Calculate_days_to_monday": ["Succeeded"]
              },
              "description": "Move to next Monday at 09:00 UTC. Remaining SLA hours carry into the business day."
            }
          },
          "else": {
            "actions": {
              "Check_business_hours": {
                "type": "If",
                "runAfter": {},
                "expression": {
                  "or": [
                    {
                      "less": [
                        "@int(formatDateTime(outputs('Calculate_raw_SLA_due_date'), 'HH'))",
                        8
                      ]
                    },
                    {
                      "greaterOrEquals": [
                        "@int(formatDateTime(outputs('Calculate_raw_SLA_due_date'), 'HH'))",
                        18
                      ]
                    }
                  ]
                },
                "actions": {
                  "Adjust_to_next_business_morning": {
                    "type": "SetVariable",
                    "inputs": {
                      "name": "SLADueDate",
                      "value": "@if(less(int(formatDateTime(outputs('Calculate_raw_SLA_due_date'), 'HH')), 8), formatDateTime(outputs('Calculate_raw_SLA_due_date'), 'yyyy-MM-ddT09:00:00Z'), formatDateTime(addDays(outputs('Calculate_raw_SLA_due_date'), 1), 'yyyy-MM-ddT09:00:00Z'))"
                    },
                    "runAfter": {},
                    "description": "If before 08:00, set to 09:00 same day. If after 18:00, set to 09:00 next day."
                  }
                },
                "else": {
                  "actions": {
                    "Set_SLA_as_calculated": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "SLADueDate",
                        "value": "@formatDateTime(outputs('Calculate_raw_SLA_due_date'), 'yyyy-MM-ddTHH:mm:ssZ')"
                      },
                      "runAfter": {}
                    }
                  }
                }
              }
            }
          }
        },
        "Recheck_adjusted_date_for_weekend": {
          "type": "If",
          "runAfter": {
            "Adjust_SLA_for_weekends": ["Succeeded"]
          },
          "expression": {
            "or": [
              {
                "equals": ["@dayOfWeek(variables('SLADueDate'))", 6]
              },
              {
                "equals": ["@dayOfWeek(variables('SLADueDate'))", 0]
              }
            ]
          },
          "actions": {
            "Push_to_monday_again": {
              "type": "SetVariable",
              "inputs": {
                "name": "SLADueDate",
                "value": "@formatDateTime(addDays(variables('SLADueDate'), if(equals(dayOfWeek(variables('SLADueDate')), 6), 2, 1)), 'yyyy-MM-ddT09:00:00Z')"
              },
              "runAfter": {}
            }
          },
          "else": {},
          "description": "Edge case: the business-hours adjustment may have landed on a weekend. Push to Monday if so."
        },
        "Update_ticket_with_assignment": {
          "type": "ApiConnection",
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['shared_sharepointonline']['connectionId']"
              }
            },
            "method": "patch",
            "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('SiteUrl')))}/tables/@{encodeURIComponent(encodeURIComponent(parameters('TicketsListId')))}/items/@{triggerBody()?['ID']}",
            "body": {
              "AssignedToClaims": "@variables('AssignedAgentEmail')",
              "SLADueDate": "@variables('SLADueDate')",
              "Status": {
                "Value": "Assigned"
              }
            }
          },
          "runAfter": {
            "Recheck_adjusted_date_for_weekend": ["Succeeded"]
          },
          "runtimeConfiguration": {
            "retryPolicy": {
              "type": "exponential",
              "count": 3,
              "interval": "PT10S",
              "minimumInterval": "PT10S",
              "maximumInterval": "PT1M"
            }
          },
          "description": "Update the ticket with the assigned agent, SLA due date, and set status to Assigned."
        }
      }
    },
    "Scope_-_Catch_Routing_Error": {
      "type": "Scope",
      "runAfter": {
        "Scope_-_Try_Route_Ticket": ["Failed", "TimedOut"]
      },
      "actions": {
        "Compose_routing_error": {
          "type": "Compose",
          "inputs": {
            "FlowName": "SD - Auto Routing & Assignment",
            "TicketItemId": "@triggerBody()?['ID']",
            "TicketTitle": "@triggerBody()?['Title']",
            "Department": "@triggerBody()?['Department']",
            "ErrorTimestamp": "@utcNow()",
            "ScopeResult": "@result('Scope_-_Try_Route_Ticket')",
            "FailedActions": "@filter(result('Scope_-_Try_Route_Ticket'), item => item?['status'] == 'Failed')"
          },
          "runAfter": {}
        },
        "Send_routing_failure_email": {
          "type": "ApiConnection",
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['shared_office365']['connectionId']"
              }
            },
            "method": "post",
            "path": "/v2/Mail",
            "body": {
              "To": "@parameters('FlowAdminEmail')",
              "Subject": "FLOW FAILURE: Auto Routing - Ticket @{triggerBody()?['ID']} (@{triggerBody()?['Title']})",
              "Body": "<p><strong>Flow:</strong> SD - Auto Routing &amp; Assignment</p><p><strong>Ticket ID:</strong> @{triggerBody()?['ID']}</p><p><strong>Title:</strong> @{triggerBody()?['Title']}</p><p><strong>Department:</strong> @{triggerBody()?['Department']}</p><p><strong>Time:</strong> @{utcNow()}</p><p><strong>Error Details:</strong><br/>@{outputs('Compose_routing_error')}</p>",
              "Importance": "High"
            }
          },
          "runAfter": {
            "Compose_routing_error": ["Succeeded"]
          }
        },
        "Update_ticket_status_to_new_on_failure": {
          "type": "ApiConnection",
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['shared_sharepointonline']['connectionId']"
              }
            },
            "method": "patch",
            "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('SiteUrl')))}/tables/@{encodeURIComponent(encodeURIComponent(parameters('TicketsListId')))}/items/@{triggerBody()?['ID']}",
            "body": {
              "Status": {
                "Value": "New"
              }
            }
          },
          "runAfter": {
            "Compose_routing_error": ["Succeeded"]
          },
          "description": "Ensure the ticket remains in New status so it can be manually assigned if auto-routing fails."
        }
      }
    }
  },
  "parameters": {
    "$connections": {
      "type": "Object",
      "defaultValue": {}
    },
    "SiteUrl": {
      "type": "String",
      "metadata": {
        "schemaName": "SiteUrl",
        "description": "SharePoint site URL"
      },
      "defaultValue": "https://contoso.sharepoint.com/sites/ServiceDesk"
    },
    "TicketsListId": {
      "type": "String",
      "defaultValue": "Tickets"
    },
    "CategoriesListId": {
      "type": "String",
      "metadata": {
        "description": "GUID or name of the Categories list. Expected fields: Title, Department, DefaultAssignee (Person), SLAHours (Number)."
      },
      "defaultValue": "Categories"
    },
    "AgentsListId": {
      "type": "String",
      "metadata": {
        "description": "GUID or name of the Agents list. Expected fields: Title, AgentEmail (Text), Department (Choice), IsActive (Yes/No), CurrentTickets (Number), MaxTickets (Number)."
      },
      "defaultValue": "Agents"
    },
    "FallbackAgentEmail": {
      "type": "String",
      "metadata": {
        "description": "Email of the fallback agent when no agents are available and no default assignee is set."
      },
      "defaultValue": "servicedesk-lead@contoso.com"
    },
    "FlowAdminEmail": {
      "type": "String",
      "defaultValue": "admin@contoso.com"
    }
  },
  "connectionReferences": {
    "shared_sharepointonline": {
      "connectionName": "shared-sharepointonline",
      "source": "Invoker",
      "id": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
      "tier": "NotSpecified"
    },
    "shared_office365": {
      "connectionName": "shared-office365",
      "source": "Invoker",
      "id": "/providers/Microsoft.PowerApps/apis/shared_office365",
      "tier": "NotSpecified"
    }
  }
}
